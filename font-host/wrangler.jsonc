{
	// Kalice font host: see README.md. Deploy with `npm run deploy` from Eric's Mac only.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rt-font-host",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	// Only our own domain: no workers.dev address and no preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "fonts.radialtimeline.com", "custom_domain": true }],
	// The fonts are staged here from ~/Documents/FONTS by scripts/stage.mjs and removed after a
	// deploy. run_worker_first sends every request through the origin check in src/index.js.
	"assets": { "directory": "./.staging", "binding": "ASSETS", "run_worker_first": true },
	"vars": { "ALLOWED_ORIGINS": "https://docs.radialtimeline.com" },
	"observability": { "enabled": false }
}
