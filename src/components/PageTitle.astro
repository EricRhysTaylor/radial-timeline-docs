---
const { title, eyebrow } = Astro.locals.starlightRoute.entry.data;
---

{eyebrow && <div class="rt-eyebrow">{eyebrow}</div>}
<h1 id="_top">{title}</h1>

<style>
	@layer starlight.core {
		.rt-eyebrow {
			margin-top: 1.25rem;
			font: 500 0.75rem/1.4 var(--sl-font-mono);
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--sl-color-gray-3);
		}
		h1 {
			margin-top: 0.5rem;
			font-family: var(--rt-display);
			font-size: clamp(2.2rem, 5vw, 3rem);
			font-weight: 600;
			line-height: 1.05;
			letter-spacing: -0.01em;
			text-wrap: balance;
			color: var(--sl-color-white);
		}
	}
</style>
